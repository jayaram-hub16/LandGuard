# ── Backend ─────────────────────────────────────────────────────
# Flask secret key — CHANGE IN PRODUCTION (min 32 chars, random)
SECRET_KEY=your-secret-key-change-this-immediately

# JWT secret (leave blank to reuse SECRET_KEY)
JWT_SECRET_KEY=

# Database URL — SQLite for local dev, PostgreSQL for production
# Local: sqlite:///landguard_dev.db (default, no configuration needed)
# Production: postgresql://USER:PASSWORD@HOST:5432/landguard_db
DATABASE_URL=

# Frontend URL for CORS allowlist (comma-separated for multiple)
FRONTEND_URL=http://localhost:5173

# Flask environment: development | testing | production
FLASK_ENV=development
FLASK_APP=run.py

# ── Admin Bootstrap ──────────────────────────────────────────────
# Used by: flask create-admin --email $ADMIN_BOOTSTRAP_EMAIL --password $ADMIN_BOOTSTRAP_PASSWORD
# Only needed if scripting admin creation; otherwise use CLI directly
ADMIN_BOOTSTRAP_EMAIL=admin@landguard.local
ADMIN_BOOTSTRAP_PASSWORD=

# ── Email (optional — for password reset, if implemented) ────────
MAIL_SERVER=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_USE_TLS=true

# ── File Storage ─────────────────────────────────────────────────
# Upload folder (local dev)
UPLOAD_FOLDER=uploads
REPORTS_FOLDER=reports_output

# ── Frontend (Vite) ──────────────────────────────────────────────
# Leave blank to use Vite proxy (dev). Set to backend public URL for production.
VITE_API_URL=
